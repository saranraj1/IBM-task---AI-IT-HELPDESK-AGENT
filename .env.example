# ==============================================================================
# AI IT HELPDESK AGENT - CONFIGURATION TEMPLATE
# Copy to .env and configure keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM: Cloud API (OpenAI / Groq / OpenRouter / OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Set to 'cloud' to prefer Cloud API, or 'ollama' to prefer local Ollama
LLM_PROVIDER=cloud

# Your Cloud API Key (Supports OpenAI, Groq, OpenRouter, Together AI, etc.)
# If left blank, the agent automatically falls back to secondary local Ollama.
CLOUD_API_KEY=your_cloud_api_key_here

# Cloud API Base URL:
# - OpenAI:     https://api.openai.com/v1
# - Groq:       https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
CLOUD_BASE_URL=https://api.openai.com/v1

# Cloud Model:
# - OpenAI:     gpt-4o-mini (or gpt-4o, gpt-3.5-turbo)
# - Groq:       llama-3.3-70b-versatile (or mixtral-8x7b-32768)
# - OpenRouter: meta-llama/llama-3.3-70b-instruct
CLOUD_MODEL=gpt-4o-mini

# Cloud Request Timeout in seconds
CLOUD_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 2. SECONDARY LLM: Local Ollama (Automatic Fallback)
# ------------------------------------------------------------------------------
# Base URL where local Ollama is running
OLLAMA_HOST=http://localhost:11434

# Primary Ollama model tag (pulled via `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2
DEFAULT_MODEL=llama3.2

# LLM Generation Temperature (0.0 for technical precision, 0.7 for conversational)
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 3. Vector Store & RAG (Retrieval-Augmented Generation)
# ------------------------------------------------------------------------------
# HuggingFace sentence-transformers model for dense vector embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ChromaDB collection & directory
CHROMA_COLLECTION_NAME=it_helpdesk_kb
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Knowledge base documentation folder (supports .txt and .md)
KNOWLEDGE_BASE_DIR=knowledge_base

# RAG chunking parameters & retrieval depth
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# ------------------------------------------------------------------------------
# 4. Database & Chat Session Persistence
# ------------------------------------------------------------------------------
DATABASE_PATH=data/helpdesk.db
DEFAULT_USER_NAME=User
TICKET_ID_PREFIX=TKT

# ------------------------------------------------------------------------------
# 5. Streamlit Application & Server
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
LOG_LEVEL=INFO
APP_ENV=development
